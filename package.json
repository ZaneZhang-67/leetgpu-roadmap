{
  "name": "leetgpu-roadmap",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "A GitHub Pages-ready LeetGPU learning roadmap and progress tracker.",
  "scripts": {
    "dev": "vite",
    "check:punctuation": "node scripts/check-no-terminal-periods.mjs",
    "check:code-blocks": "node scripts/check-shiki-code-blocks.mjs",
    "check:line-numbers": "node scripts/check-reference-line-numbers.mjs",
    "generate:code": "node scripts/generate-highlighted-code.mjs",
    "generate:content": "node scripts/generate-content.mjs",
    "build": "npm run check:punctuation && npm run generate:code && npm run generate:content && npm run check:code-blocks && npm run check:line-numbers && vite build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "fast-glob": "^3.3.3",
    "shiki": "4.6.0",
    "vite": "^7.2.2"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "marked": "^18.1.3"
  }
}
