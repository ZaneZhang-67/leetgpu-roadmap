{
  "name": "leetgpu-roadmap",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=22"
  },
  "description": "A GitHub Pages-ready LeetGPU learning roadmap and progress tracker.",
  "scripts": {
    "predev": "npm run generate:content",
    "dev": "vite",
    "check:punctuation": "node scripts/check-no-terminal-periods.mjs",
    "check:code-blocks": "node scripts/check-shiki-code-blocks.mjs",
    "check:line-numbers": "node scripts/check-reference-line-numbers.mjs",
    "check:coverage": "node scripts/check-challenge-coverage.mjs",
    "check:catalog": "node scripts/sync-leetgpu-catalog.mjs --check",
    "sync:catalog": "node scripts/sync-leetgpu-catalog.mjs",
    "cache:challenges": "node scripts/cache-leetgpu-challenges.mjs",
    "generate:content": "node scripts/generate-content.mjs",
    "check:navigation": "node scripts/check-article-navigation.mjs",
    "build": "npm run check:punctuation && npm run generate:content && npm run check:coverage && npm run check:navigation && npm run check:code-blocks && npm run check:line-numbers && vite build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "fast-glob": "^3.3.3",
    "shiki": "4.6.0",
    "vite": "^7.2.2"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "marked": "^18.1.3"
  }
}
