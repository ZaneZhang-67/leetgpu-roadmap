          <mxGeometry height="36" width="1200" x="100" y="745" as="geometry" />
        </mxCell>
        <mxCell id="inner-formula" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontFamily=IBM Plex Mono;fontSize=18;fontColor=#172B45;" value="s = a10×b02 + a11×b12 + a12×b22 + a13×b32" vertex="1">
          <mxGeometry height="30" width="1100" x="100" y="795" as="geometry" />
