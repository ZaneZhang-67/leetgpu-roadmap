        <mxCell id="inner-code" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontFamily=IBM Plex Mono;fontSize=18;fontColor=#172B45;" value="for (int i = 0; i &lt; N; i++)  s += A[row*N + i] * B[i*K + col];" vertex="1">
