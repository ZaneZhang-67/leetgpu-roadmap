        </mxCell>
        <mxCell id="inner-note" parent="1" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=left;spacingLeft=16;fontFamily=PingFang SC;fontSize=16;fontColor=#60738B;fillColor=#E5F0FC;strokeColor=none;" value="i 同时选择 A 第 row 行的第 i 个元素，以及 B 第 col 列的第 i 个元素；循环 N 次后得到一个标量，正好写入 C[row,col]" vertex="1">
          <mxGeometry height="35" width="1590" x="100" y="875" as="geometry" />
        </mxCell>
