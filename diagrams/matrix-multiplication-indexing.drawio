          <mxGeometry height="36" width="850" x="100" y="975" as="geometry" />
        </mxCell>
        <mxCell id="boundary-main" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontFamily=PingFang SC;fontSize=19;fontStyle=1;fontColor=#172B45;" value="Grid 向上取整后，边缘 Block 可能产生超出 C(M×K) 的线程，&lt;span style=&quot;background-color: rgb(128, 255, 0);&quot;&gt;多余的线程访问不存在的数据&lt;/span&gt;" vertex="1">
          <mxGeometry height="30" width="1000" x="100" y="1015" as="geometry" />
        </mxCell>
        <mxCell id="boundary-note" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;fontFamily=PingFang SC;fontSize=16;fontColor=#60738B;" value="合法线程才读取 A、B 并写 C；越界线程直接退出，避免访问不存在的行或列。N 不需要在线程边界中判断，因为 for 循环已经严格限制为 0 ≤ i &lt; N。" vertex="1">
          <mxGeometry height="28" width="1550" x="100" y="1048" as="geometry" />
        </mxCell>
